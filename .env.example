# Evidence Review 8810 — local development
ENVIRONMENT=development
ENABLE_DOCS=true
ENABLE_AUTH=false
EVIDENCE_REVIEW_PORT=8810

# Port 5446, NOT 5432. A developer machine usually has its own Postgres on 5432
# (Homebrew's default), so a copy-pasted 5432 silently connects to the wrong
# server: `alembic upgrade head` succeeds, the service starts, imports return
# 201 — and every row lands in a database nobody is looking at. Use a dedicated
# container port for this service and check it is free before binding it, because
# several agents share this host. Bring-up is in README.md § Local development.
#
# Runtime connects as the NON-owner role so RLS cannot be disabled at runtime.
DATABASE_URL=postgresql+psycopg://evidence_review_app:CHANGE_ME@localhost:5446/evidence_review
# Migrations connect as the OWNER role.
MIGRATION_DATABASE_URL=postgresql+psycopg://evidence_review:CHANGE_ME@localhost:5446/evidence_review

DISCOVERY_ENGINE_URL=http://localhost:8081
KEYCLOAK_URL=https://keycloak.example
KEYCLOAK_REALM=portal
LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# The worker loop (src/worker.py) and its heartbeat. All four have working
# defaults; they are listed so the names are discoverable, not because anything
# must set them.
# ---------------------------------------------------------------------------
# WORKER_INTERVAL_SECONDS=5
# Where a COMPLETED tick records itself. `python -m worker_heartbeat` reads it
# and is the liveness probe — see README.md § The worker's heartbeat.
# WORKER_HEARTBEAT_PATH=/tmp/evidence-review-worker/heartbeat.json
# Multiplied by the tick interval the LOOP recorded to get the staleness bound;
# never a bound on its own, or a 60s worker dies on its first tick.
# WORKER_HEARTBEAT_STALE_MULTIPLE=6
# Seconds between "alive, and here is what I have done" log lines. 300 is 288
# lines a day; one per tick at 5s would be 17,280 of `relayed=0`.
# WORKER_HEARTBEAT_LOG_SECONDS=300
# Where the WORKER serves its own /metrics. It needs its own listener and cannot
# borrow the API's on 8810: the six relay counters live in `worker._Counters`,
# in the worker's memory, so a counter exported from the API process would read
# 0 for the life of the pod — see src/metrics.py. `0` disables the listener.
# WORKER_METRICS_PORT=9810
# WORKER_METRICS_HOST=0.0.0.0
